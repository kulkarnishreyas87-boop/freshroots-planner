# Copy to .env.local and fill in. Never commit .env.local.

# ---- Neon (Postgres) -------------------------------------------------------
# REQUIRED. Neon console > your project > Connect > copy the connection string
# (it starts with postgresql:// and ends with ?sslmode=require).
DATABASE_URL=

# ---- Gemini ----------------------------------------------------------------
# REQUIRED. Google AI Studio > Get API key.
GEMINI_API_KEY=
# REQUIRED. The exact model id from Google AI Studio's model list (a Flash model).
# No default on purpose: the app will not guess a model name.
GEMINI_MODEL=

# ---- Cron (Vercel) ---------------------------------------------------------
# REQUIRED on Vercel. Any long random string. Vercel sends it to /api/cron as a Bearer token.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---- Dashboard login -------------------------------------------------------
# Optional locally. Set it on Vercel so the dashboard is not open to anyone with the link.
SITE_PASSWORD=

# ---- Zoho Inventory (raises the PO when Raghav approves) --------------------
# Zoho API Console > Self Client > Client Secret tab.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Self Client > Generate Code with scopes
#   ZohoInventory.purchaseorders.CREATE,ZohoInventory.purchaseorders.UPDATE,ZohoInventory.items.READ,ZohoInventory.contacts.READ
# then: npm run zoho:token -- <code>
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Data centre. India shown; .com/.eu/.com.au etc. for others.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/inventory/v1
# Optional. Only needed if Zoho asks for it during the token exchange.
ZOHO_REDIRECT_URI=
# draft (default): POs wait in Zoho as drafts. issued: marked issued right after creation.
ZOHO_PO_STATUS=draft
